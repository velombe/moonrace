# Secret used to sign run tokens (anti-cheat). Use a long random string in production.
RUN_SECRET=change-me-to-a-long-random-string

# Optional: Upstash Redis for leaderboards and daily stats.
# Without these, the app uses an in-memory store (fine for local dev, resets on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used for share links and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: allow test flights (/?test=moon) in a production build. Always allowed in dev.
# Test flights skip ahead, have no collisions and are never submitted.
NEXT_PUBLIC_TEST_FLIGHTS=
